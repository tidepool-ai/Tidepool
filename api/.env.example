# Copy to .env for local runs (git-ignored), then load it: set -a && . ./.env && set +a
# Never commit real values. Full list: docs/ENVIRONMENT.md
CORS_ORIGINS=http://localhost:4200
DATABASE_URL=postgresql+asyncpg://tidepool:tidepool@localhost:5432/tidepool
# Auth. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
APP_URL=http://localhost:4200
JWT_SECRET=
REFRESH_COOKIE_SECURE=true
# Sign-in emails (Resend). With a key set, links are emailed and never logged.
RESEND_API_KEY=
EMAIL_FROM=
# Without a key: write sign-in links to the log (default: on when APP_ENV=development). Test deploys only.
LOG_MAGIC_LINKS=
# Largest page document accepted (bytes of JSON). Default 1000000.
MAX_PAGE_CONTENT_BYTES=
# Image uploads (S3 or another bucket that supports POST policy uploads). Empty S3_BUCKET = uploads off.
# Local: run `python -m scripts.dev_storage`, then use tidepool / http://127.0.0.1:9000 / dev / dev.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Largest image accepted (bytes). Default 26214400 (25 MB).
MAX_UPLOAD_BYTES=
# Realtime (live editing). REDIS_URL is only needed with more than one API worker.
# The API's public https address when the web app is on another host (Render: set automatically).
PUBLIC_API_URL=
REDIS_URL=
# Seconds after the last edit before a live document is saved. Default 2.
REALTIME_SAVE_DELAY_SECONDS=
# Largest WebSocket message accepted (bytes). Default 1000000.
MAX_REALTIME_MESSAGE_BYTES=
# AI features (hosted GLM, OpenAI-compatible)
GLM_BASE_URL=
GLM_API_KEY=
GLM_MODEL=
# Tests use DATABASE_URL with "_test" appended unless set
TEST_DATABASE_URL=
