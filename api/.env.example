# Copy to .env for local runs. Never commit real values.
CORS_ORIGINS=http://localhost:4200
DATABASE_URL=postgresql+asyncpg://tidepool:tidepool@localhost:5432/tidepool
# Auth. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
APP_URL=http://localhost:4200
JWT_SECRET=
REFRESH_COOKIE_SECURE=true
# AI features (hosted GLM, OpenAI-compatible)
GLM_BASE_URL=
GLM_API_KEY=
GLM_MODEL=
# Tests use DATABASE_URL with "_test" appended unless set
TEST_DATABASE_URL=
